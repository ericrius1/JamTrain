{
  "name": "jam-train",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "spacetime:publish": "spacetime publish --server maincloud -p ./spacetimedb jam-train -y && npm run spacetime:generate",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb -y"
  },
  "dependencies": {
    "@svenflow/micro-handpose": "0.3.0",
    "@tweakpane/core": "^2.0.5",
    "@types/stats.js": "^0.17.4",
    "spacetimedb": "2.1.0",
    "stats.js": "^0.17.0",
    "three": "0.184.0",
    "three-mesh-bvh": "^0.9.9",
    "tone": "15.1.22",
    "tweakpane": "^4.0.5",
    "webmidi": "^3.1.16"
  },
  "devDependencies": {
    "@types/three": "^0.184.0",
    "playwright": "^1.59.1",
    "typescript": "6.0.3",
    "vite": "8.0.10"
  }
}
